{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "es6", // JSバージョン指定
    "types": [],
    // For nodejs:
    // "lib": [ // TSが提供している定義ファイルの指定
    //   "ES6",
    //   "DOM"
    // ],
    // "allowJs": true,
    // "checkJs": true, // JSファイルもエラーチェックする
    // "jsx": "preserve", //リアクトのために使う
    "declaration": true,
    "declarationMap": true,
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true, // JS→TSのマッピング

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strictBindCallApply": false,

    "noUnusedLocals": false, // 使用していないローカル変数のエラーチェック
    "noUnusedParameters": false, // 使用していない関数の引数のエラーチェック
    "noImplicitReturns": false, // 暗黙的なリターンのチェック

    "forceConsistentCasingInFileNames": true, // ファイル名の大文字小文字をチェック
  },
  "include": [ //コンパイルするものを設定
    "index.ts" 
    // ワイルドカードも使えるし"exclude"でしたことのある設定は設定可能
  ],
  "exclude": [ //コンパイルしない設定
    "compiler.ts", //rootディレクトリのもの
    "*/compiler.ts", //rootディレクトリ/フォルダ/内のもの
    "**/compiler.ts", //どこにいても
    "*.spec.ts", //ワイルドカード指定ができる
    "node_modules", // "exclude"を記載しない場合は自動でコンパイルされないようになっているが、"exclude"を記載する場合は明示的に書かなければいけない
  ],
  "files": [ //ファイルを指定
    "tem/compiler.ts"
  ]
}
