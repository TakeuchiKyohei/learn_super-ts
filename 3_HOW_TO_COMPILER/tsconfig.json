{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": [ //コンパイルするものを設定
    "index.ts" 
    // ワイルドカードも使えるし"exclude"でしたことのある設定は設定可能
  ],
  "exclude": [ //コンパイルしない設定
    "compiler.ts", //rootディレクトリのもの
    "*/compiler.ts", //rootディレクトリ/フォルダ/内のもの
    "**/compiler.ts", //どこにいても
    "*.spec.ts", //ワイルドカード指定ができる
    "node_modules", // "exclude"を記載しない場合は自動でコンパイルされないようになっているが、"exclude"を記載する場合は明示的に書かなければいけない
  ],
  "files": [ //ファイルを指定
    "tem/compiler.ts"
  ]
}
